*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Tooling
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.DS_Store

# Secrets / tokens (never commit)
**/github_token
**/*token*.txt
**/*.pem
**/*.key
**/*secret*
**/credentials*
.github_token
id_token
!.env.example

# Benchmark artifacts + harvest DBs (live on DGX only)
artifacts/
runs/
logs/
*.log
*.patch
*.sqlite
*.sqlite-*
*.sqlite3
data/*.sqlite
data/*.sqlite-*
data/**/*.sqlite
data/**/*.sqlite-*
data/frozen/*.sqlite
data/frozen/*.sqlite-*
# Shard SQLite + manifest live under data/shards/ (never commit multi-GB DBs).
# Track only the README so the layout is documented in git.
data/shards/*
!data/shards/README.md
data/shards_manifest.json
data/eval/
!.gitkeep

# Legacy Mac mirror path (pre-repo data/shards/); may still hold patterns/eval
ace-bench-data/
